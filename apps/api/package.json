{
  "name": "@riz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/run-migrate.ts",
    "test": "tsx --test src/*.test.ts src/*/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:replicas": "tsx --test ../../tests/load/equivalence.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/pg": "8.23.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@openfga/sdk": "0.9.7",
    "@openfga/syntax-transformer": "0.2.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "jose": "6.2.14",
    "pg": "8.23.1"
  }
}
