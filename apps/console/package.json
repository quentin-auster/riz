{
  "name": "@riz/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run test:server && pnpm run test:components",
    "test:server": "tsx --test src/lib/server/*.test.ts",
    "test:components": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.4.0",
    "@sveltejs/kit": "2.46.5",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.1.3",
    "svelte": "5.41.0",
    "svelte-check": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "vitest": "3.2.7"
  }
}
