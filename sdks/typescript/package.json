{
  "name": "@riz/sdk",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./databricks": {
      "types": "./dist/databricks.d.ts",
      "default": "./dist/databricks.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:databricks": "tsx --test tests/databricks.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
