{
  "$schema": "https://biomejs.dev/schemas/2.2.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.svelte-kit",
      "!**/node_modules",
      "!**/.venv",
      "!**/*.svelte",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": { "enabled": true }
}
