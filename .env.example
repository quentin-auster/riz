# Local development only. Copy to .env and replace every value.
# Use URL-safe characters only (letters, digits, - _ . ~): the OpenFGA passwords are
# embedded in a postgres:// URI. Passwords are applied when the database volume is first
# created; after changing one, run `make down` with `-v` (docker compose down -v) to reset.
POSTGRES_ADMIN_PASSWORD=change-me-admin
OPENFGA_DB_PASSWORD=change-me-openfga
RIZ_DB_PASSWORD=change-me-riz

# Host-run tooling (make migrate, API integration tests); riz role, riz database.
RIZ_DATABASE_URL=postgres://riz:change-me-riz@localhost:5432/riz
